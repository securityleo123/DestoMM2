newActionBtn(tabFling,"🚀  FLING NOW",T.ACCENT,20,function()
    -- fling logic fires below
    local targets={}
    if flingTarget=="Murderer" then targets=getMurderers()
    elseif flingTarget=="Sheriff" then targets=getSheriffs()
    elseif flingTarget=="Random" then
        local all={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp then table.insert(all,p) end end
        if #all>0 then table.insert(targets,all[math.random(#all)]) end
    elseif flingTarget=="Select" then
        if selectedPlayer then table.insert(targets,selectedPlayer) end
    elseif flingTarget=="All" then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp then table.insert(targets,p) end end
    end
    for _,target in ipairs(targets) do
        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP=target.Character.HumanoidRootPart
            -- teleport to target, apply massive velocity
            hrp.CFrame=tHRP.CFrame
            task.wait(0.05)
            tHRP.AssemblyLinearVelocity=Vector3.new(
                math.random(-1,1)*9999,
                9999,
                math.random(-1,1)*9999
            )
            tHRP.AssemblyAngularVelocity=Vector3.new(9999,9999,9999)
        end
    end
end)

