-- ░░ MM2 ROLE DETECTION ░░
-- MM2 stores roles in player.Character or via folder tags
-- roles: "Murderer" | "Sheriff" | "Innocent"
local function getRole(player)
    if not player.Character then return "Innocent" end
    -- MM2 tags via BoolValues or StringValue inside Character
    if player.Character:FindFirstChild("mm2_murderer")
    or player.Character:FindFirstChild("Murderer") then return "Murderer" end
    if player.Character:FindFirstChild("mm2_sheriff")
    or player.Character:FindFirstChild("Sheriff") then return "Sheriff" end
    -- also check via MM2 GameScript values in workspace
    local mm2 = workspace:FindFirstChild("GameScript") or workspace:FindFirstChild("MM2")
    if mm2 then
        local murderer = mm2:FindFirstChild("Murderer")
        if murderer and tostring(murderer.Value) == player.Name then return "Murderer" end
        local sheriff = mm2:FindFirstChild("Sheriff")
        if sheriff and tostring(sheriff.Value) == player.Name then return "Sheriff" end
    end
    -- tool check: murderer carries knife, sheriff carries gun
    for _,tool in ipairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("knife") or n:find("blade") then return "Murderer" end
            if n:find("gun") or n:find("sheriff") or n:find("revolver") then return "Sheriff" end
        end
    end
    return "Innocent"
end

local function getMurderers()
    local t={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and getRole(p)=="Murderer" then table.insert(t,p) end
    end
    return t
end

local function getSheriffs()
    local t={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and getRole(p)=="Sheriff" then table.insert(t,p) end
    end
    return t
end

