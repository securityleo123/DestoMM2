local function buildPlayerList(parent, startOrder, onSelect)
    local listFrame=Instance.new("Frame",parent)
    listFrame.Size=UDim2.new(1,0,0,0); listFrame.AutomaticSize=Enum.AutomaticSize.Y
    listFrame.BackgroundTransparency=1; listFrame.LayoutOrder=startOrder
    local lay=Instance.new("UIListLayout",listFrame)
    lay.Padding=UDim.new(0,5); lay.SortOrder=Enum.SortOrder.LayoutOrder
    local rowCache={}
    local function refresh()
        for _,r in pairs(rowCache) do r:Destroy() end; rowCache={}
        local i=0
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp then
                i=i+1
                local row=Instance.new("Frame",listFrame)
