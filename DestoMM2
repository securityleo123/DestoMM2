-- ESP
local espObjs={MurdererESP={},SheriffESP={},InnocentESP={}}
local espColors={
    MurdererESP=Color3.fromRGB(255,60,60),
    SheriffESP =Color3.fromRGB(60,160,255),
    InnocentESP=Color3.fromRGB(60,220,60),
}
local function clearESP(k)
    for _,v in ipairs(espObjs[k]) do if v and v.Parent then v:Destroy() end end; espObjs[k]={}
end
local function makeHL(adornee,color,k)
    if adornee:FindFirstChildOfClass("Highlight") then return end
    local hl=Instance.new("Highlight")
    hl.FillColor=color; hl.OutlineColor=T.GLOW
    hl.FillTransparency=0.45; hl.OutlineTransparency=0
    hl.Adornee=adornee; hl.Parent=adornee
    table.insert(espObjs[k],hl)
end

-- nametag above head
local nameTags={}
local function refreshNameTags()
    for p,tag in pairs(nameTags) do
        if tag and tag.Parent then tag:Destroy() end end
    nameTags={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and p.Character then
            local role=getRole(p)
            local shouldTag=(state.ExposeMurd and role=="Murderer")
                         or (state.ExposeShrf and role=="Sheriff")
            if shouldTag then
                local head=p.Character:FindFirstChild("Head")
                if head then
                    local bg=Instance.new("BillboardGui",head)
                    bg.Size=UDim2.new(0,120,0,30); bg.StudsOffset=Vector3.new(0,2.5,0)
                    bg.AlwaysOnTop=true
                    local tl=Instance.new("TextLabel",bg)
                    tl.Text="["..role.."] "..p.Name
                    tl.Font=Enum.Font.GothamBold; tl.TextSize=13
                    tl.TextColor3=role=="Murderer" and T.RED or T.BLUE
                    tl.BackgroundTransparency=1; tl.Size=UDim2.new(1,0,1,0)
                    tl.TextStrokeTransparency=0
                    nameTags[p]=bg
                end
            end
        end
    end
end

-- expose: broadcast in chat once on enable, not spam
local exposedMurd={}
local exposedShrf={}
RunService.Heartbeat:Connect(function()
    -- ESP
    if state.MurdererESP then
        clearESP("MurdererESP")
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp and p.Character and getRole(p)=="Murderer" then
                makeHL(p.Character,espColors.MurdererESP,"MurdererESP") end end
    else clearESP("MurdererESP") end

    if state.SheriffESP then
        clearESP("SheriffESP")
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp and p.Character and getRole(p)=="Sheriff" then
                makeHL(p.Character,espColors.SheriffESP,"SheriffESP") end end
    else clearESP("SheriffESP") end

    if state.InnocentESP then
        clearESP("InnocentESP")
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp and p.Character and getRole(p)=="Innocent" then
                makeHL(p.Character,espColors.InnocentESP,"InnocentESP") end end
    else clearESP("InnocentESP") end

    -- nametags
    refreshNameTags()

    -- expose murderer — chat broadcast once per unique player
    if state.ExposeMurd then
        for _,p in ipairs(getMurderers()) do
            if not exposedMurd[p.UserId] then
                exposedMurd[p.UserId]=true
                local ok,_=pcall(function()
                    game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents
                        .SayMessageRequest:FireServer(
                            "🔪 MURDERER: "..p.Name.." | Desto Hub","All")
                end)
            end
        end
    else exposedMurd={} end

    -- expose sheriff
    if state.ExposeShrf then
        for _,p in ipairs(getSheriffs()) do
            if not exposedShrf[p.UserId] then
                exposedShrf[p.UserId]=true
                local ok,_=pcall(function()
                    game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents
                        .SayMessageRequest:FireServer(
                            "🔫 SHERIFF: "..p.Name.." | Desto Hub","All")
                end)
            end
        end
    else exposedShrf={} end

    -- hitbox expander
    if state.HitboxExpander then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=lp and p.Character then
                local h=p.Character:FindFirstChild("HumanoidRootPart")
                if h then h.Size=Vector3.new(8,8,8) end
            end
        end
    end
end)

-- ░░ AUTO GRAB GUN ░░
-- MM2 gun drops appear as a Tool in workspace named "Sheriff Gun" or similar
-- We watch workspace for any Tool with "gun" in name and move it to lp backpack
local grabbedGun=false
workspace.DescendantAdded:Connect(function(obj)
    if not state.AutoGrabGun then return end
    if obj:IsA("Tool") then
        local n=obj.Name:lower()
        if n:find("gun") or n:find("revolver") or n:find("sheriff") then
            if obj.Parent~=lp.Backpack and obj.Parent~=lp.Character then
                task.wait(0.05)
                obj.Parent=lp.Backpack
                grabbedGun=true
            end
        end
    end
end)

-- ░░ AUTO SHOOT MURDERER ░░
-- Teleports Sam to murderer when murderer fires (tool activated)
-- then equips gun and fires
local autoShootConn={}
local function setupAutoShoot()
    for _,c in ipairs(autoShootConn) do c:Disconnect() end; autoShootConn={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and getRole(p)=="Murderer" and p.Character then
            for _,tool in ipairs(p.Character:GetChildren()) do
                if tool:IsA("Tool") then
                    local c=tool.Activated:Connect(function()
                        if not state.AutoShootMurd then return end
                        -- teleport to murderer
                        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            hrp.CFrame=p.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,2.5)
                        end
                        -- equip and fire gun if in backpack
                        task.wait(0.05)
                        for _,t in ipairs(lp.Backpack:GetChildren()) do
                            local tn=t.Name:lower()
                            if tn:find("gun") or tn:find("revolver") or tn:find("sheriff") then
                                lp.Character.Humanoid:EquipTool(t)
                                task.wait(0.1)
                                if t.Parent==lp.Character then
                                    t:Activate()
                                end
                                break
                            end
                        end
                    end)
                    table.insert(autoShootConn,c)
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if state.AutoShootMurd then setupAutoShoot() end
end)

-- ░░ KILL ALL (as murderer) ░░
-- teleport-kill: move Sam's character on top of each player rapidly
local killCooldown=0
RunService.Heartbeat:Connect(function()
    if not state.KillAll then return end
    local now=tick(); if now-killCooldown<0.3 then return end
    killCooldown=now
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid")
        and p.Character.Humanoid.Health>0 then
            hrp.CFrame=p.Character.HumanoidRootPart.CFrame
            task.wait(0.05)
            -- equip knife and activate
            for _,t in ipairs(lp.Character:GetChildren()) do
                if t:IsA("Tool") then
                    local tn=t.Name:lower()
                    if tn:find("knife") or tn:find("blade") then
                        t:Activate(); break end
                end
            end
            break -- one per tick, moves to next on next Heartbeat cycle
        end
    end
end)

